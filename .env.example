# ==============================================================
# Revideo Server Configuration
# Copy this file to .env and edit values as needed.
# ==============================================================

# Server port (default: 3001)
REVIDEO_PORT=3001

# Data directory (default: ./data)
# REVIDEO_DATA_DIR=data

# ==============================================================
# Translation — OpenAI-compatible API
# For Volcengine Ark online inference:
#   Base URL: https://ark.cn-beijing.volces.com/api/v3
#   Model: your Ark Model ID or inference endpoint ID
#   API key: create it in the Volcengine Ark console
# ==============================================================
# TRANSLATE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# TRANSLATE_MODEL=doubao-seed-2-0-mini-260428
# TRANSLATE_API_KEY_ENV=VOLCENGINE_API_KEY
# TRANSLATE_THINKING_TYPE=disabled

# API keys (set the env var referenced by TRANSLATE_API_KEY_ENV)
# VOLCENGINE_API_KEY=your-key-here
# ARK_API_KEY=your-key-here

# ==============================================================
# Optional: Custom binary paths (auto-detected if not set)
# ==============================================================
# YT_DLP_BIN=/usr/local/bin/yt-dlp
# FFMPEG_BIN=/usr/local/bin/ffmpeg
# FFPROBE_BIN=/usr/local/bin/ffprobe
