<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.revideo.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd '{{INSTALL_DIR}}' &amp;&amp; exec {{NODE_BIN}} dist/server.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:{{HOME}}/.local/bin:{{INSTALL_DIR}}/node_modules/.bin</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>{{INSTALL_DIR}}</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>{{INSTALL_DIR}}/data/server.log</string>

  <key>StandardErrorPath</key>
  <string>{{INSTALL_DIR}}/data/server-error.log</string>
</dict>
</plist>
